    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid #000000;
    padding: 4px 8px;
    text-align: center;
  }
  td {
    border: 1px solid #000000;
    padding: 3px 6px;
    vertical-align: middle;
  }
  tr:nth-child(even) td { background-color: #F2F2F2; }
  tr:nth-child(odd)  td { background-color: #FFFFFF; }
</style>
</head>
